# ============ 哲唯科技~GEO交付平台 · 后端环境变量示例 ============
# 复制为 server/.env 并按需修改；或直接以系统环境变量注入

# 主服务端口（API）
PORT=8787
# 监听地址
HOST=0.0.0.0

# 沙箱模式：true=发布走模拟；false=调用真实平台 API（需配置凭证）
SANDBOX_MODE=true

# 大模型（OpenAI 兼容，用于 AI 内容生成与 GEO 实测问答）
# 示例（DeepSeek）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx
# 示例（OpenAI）：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxxx
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# OAuth 回调地址（真实授权时需公网可达；沙箱可保持默认）
OAUTH_REDIRECT=http://localhost:8787/api/channels/oauth/callback

# 10 个分发平台服务端口（对应“分发平台端口绑定”需求）
BIND_PORTS=9091,9092,9093,9094,9095,9096,9097,9098,9099,9100

# ---------- 平台开发者凭证（真实发布/授权时填入） ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ZHIHU_CLIENT_ID=
ZHIHU_CLIENT_SECRET=
BAIJIA_TOKEN=
XIAOHONGSHU_CLIENT_ID=
XIAOHONGSHU_CLIENT_SECRET=
TOUTIAO_CLIENT_ID=
TOUTIAO_CLIENT_SECRET=
WEIBO_APP_KEY=
WEIBO_APP_SECRET=
CSDN_USERNAME=
CSDN_PASSWORD=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
SHIPINHAO_APP_ID=
SHIPINHAO_APP_SECRET=
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
